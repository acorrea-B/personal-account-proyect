# Template del .env local (cópialo a .env y llena los valores).
# El .env real NUNCA va al repo (gitignore). El servidor de desarrollo
# (cargo run) y sqlx leen estos valores.

# Postgres DIRECTO de Supabase local (supabase start → puerto 54322).
# En un proyecto real: la conexión directa db.<ref>.supabase.co:5432
# (nunca el pooler — R10).
MIGRATIONS_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# Servidor de desarrollo (cargo run) — la API usa el pooler.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
SERVICE_ROLE_KEY=<secreto de Supabase local>
# Sistema nuevo de claves: la publicable acompana siempre (config T008).
SUPABASE_PUBLISHABLE_KEY=<clave publicable anon/sb_publishable>
# ENV=development activa el tracing legible (§13.4)
ENV=development

