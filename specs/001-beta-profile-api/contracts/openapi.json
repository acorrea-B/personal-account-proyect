{
  "openapi": "3.0.3",
  "info": {
    "title": "Perfil API (beta)",
    "version": "0.1.3",
    "description": "API de perfil profesional serverless — Rust + Scaleway Functions + Supabase. Errores canónicos RFC 7807 (application/problem+json): la fuente completa es contracts/errors.md. Credenciales: Authorization: Bearer <access_token> de Supabase (verificación ES256 vía JWKS). Rate limits R2: login fallido 5/min, resend 3/10min, escritura CV 10/min/user.",
    "contact": { "name": "acorrea-B" }
  },
  "servers": [
    {
      "url": "https://perfilapiproductionjcymr0rx-api.functions.fnc.fr-par.scw.cloud",
      "description": "Producción"
    },
    { "url": "http://127.0.0.1:8080", "description": "Local (servidor de desarrollo)" }
  ],
  "tags": [
    { "name": "health" },
    { "name": "auth", "description": "register/resend/refresh públicos; revoke protegido" },
    { "name": "profile", "description": "protegido" },
    { "name": "cv", "description": "protegido; versión histórica con retención de 10" }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["health"],
        "summary": "Health probe del smoke post-deploy",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "ok",
            "content": { "text/plain": { "schema": { "type": "string", "example": "ok" } } }
          }
        }
      }
    },
    "/v1/auth/register": {
      "post": {
        "tags": ["auth"],
        "summary": "Registro (FR-001..003, US1)",
        "operationId": "register",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RegisterRequest" },
              "example": { "email": "juan@Example.com", "password": "contraseña1" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuario creado (email normalizado, nunca credenciales). Lateral: email de verificación.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RegisterResponse" } } }
          },
          "409": { "$ref": "#/components/responses/EmailExists" },
          "422": {
            "description": "email-malformed o weak-password",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
          },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/Dependency" }
        }
      }
    },
    "/v1/auth/resend-verification": {
      "post": {
        "tags": ["auth"],
        "summary": "Reenvío de verificación (FR-005) — respuesta genérica siempre (FR-006)",
        "operationId": "resendVerification",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ResendRequest" },
              "example": { "email": "juan@example.com" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Genérica siempre (no revela existencia)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["message"],
                  "properties": { "message": { "type": "string" } }
                },
                "example": { "message": "Si el email corresponde a una cuenta pendiente, se envió un enlace." }
              }
            }
          },
          "422": { "description": "email-malformed", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/Dependency" }
        }
      }
    },
    "/v1/auth/login": {
      "post": {
        "tags": ["auth"],
        "summary": "Inicio de sesión (FR-006, US2)",
        "operationId": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" },
              "example": { "email": "juan@example.com", "password": "contraseña1" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Par de credenciales",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TokenPair" } } }
          },
          "401": {
            "description": "invalid-credentials — idéntico y comparable temporalmente para password errónea / email inexistente (SC-004)",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
          },
          "403": {
            "description": "email-not-verified (con can_resend: true)",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/v1/auth/refresh": {
      "post": {
        "tags": ["auth"],
        "summary": "Renovación (FR-007/008) — el refresh_token ES la autenticación",
        "operationId": "refresh",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RefreshRequest" },
              "example": { "refresh_token": "<token>" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Par nuevo",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TokenPair" } } }
          },
          "401": {
            "description": "invalid-refresh-token (expirado/no existe) o refresh-token-reused (la sesión completa se invalida)",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/v1/auth/revoke": {
      "post": {
        "tags": ["auth"],
        "summary": "Revocación (FR-009) — protegido; cumple el rol de logout en la beta",
        "operationId": "revoke",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "content": { "application/json": { "schema": { "type": "object" }, "example": {} } } },
        "responses": {
          "204": { "description": "Sin body" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/Dependency" }
        }
      }
    },
    "/v1/profile": {
      "get": {
        "tags": ["profile"],
        "summary": "Consultar el propio perfil (US3, FR-012/013)",
        "operationId": "getProfile",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "El perfil del user_id del token, y solo ese. Sin not-found: la cuenta verificada siempre tiene perfil (FR-004).",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProfileEnvelope" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      },
      "put": {
        "tags": ["profile"],
        "summary": "Actualizar el propio perfil (FR-012/014) — put completo; escritura optimista",
        "operationId": "putProfile",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "$ref": "#/components/parameters/IfUnmodifiedSince"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ProfileUpdate" },
              "example": {
                "full_name": "Juan Perez",
                "headline": "Desarrollador backend",
                "bio": "10 años en sistemas distribuidos...",
                "location": "Buenos Aires, AR",
                "links": [
                  { "type": "linkedin", "url": "https://www.linkedin.com/in/juanperez" },
                  { "type": "github", "url": "https://github.com/juanperez" }
                ],
                "skills": ["rust", "aws"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Perfil completo actualizado",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProfileEnvelope" } } }
          },
          "412": {
            "description": "stale-version (con current_updated_at en el problema)",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" }, "example": { "type": "stale-version", "title": "Stale Version", "status": 412, "detail": "la versión del recurso cambió", "instance": "/v1/profile", "current_updated_at": "2026-10-21T13:00:00Z" } } }
          },
          "422": {
            "description": "profile-invalid-field — extensiones por campo: fields: {\"<campo>\": \"<motivo>\"}",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/v1/cv/text": {
      "post": {
        "tags": ["cv"],
        "summary": "Guardar CV (US4, FR-015/016/017) — transaccional todo-o-nada (ADR 0013)",
        "operationId": "putCvText",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/IfUnmodifiedSince" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CvSaveRequest" },
              "example": { "content": "Juan Perez\nDesarrollador backend\n\nEXPERIENCIA\n..." }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Guardado; previous_version_archived=false en el primer guardado",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CvSaveResponse" } } }
          },
          "412": {
            "description": "stale-version — difiere del vigente; nada se archiva (la primera escritura no requiere la cabecera)",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
          },
          "413": {
            "description": "cv-too-large (con max_bytes en el problema)",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
          },
          "422": { "description": "cv-invalid-encoding", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/Dependency" }
        }
      },
      "get": {
        "tags": ["cv"],
        "summary": "Leer el CV vigente",
        "operationId": "getCvText",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "CV vigente",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CvEnvelope" } } }
          },
          "404": { "$ref": "#/components/responses/NotFound" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/v1/cv/versions": {
      "get": {
        "tags": ["cv"],
        "summary": "Listar historial (FR-018) — solo metadatos, máx 10, más recientes primero",
        "operationId": "getCvVersions",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Versiones archivadas",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CvVersionsEnvelope" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/v1/cv/versions/{id}": {
      "get": {
        "tags": ["cv"],
        "summary": "Leer una versión (FR-018)",
        "operationId": "getCvVersion",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Versión archivada",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CvVersionEnvelope" } } }
          },
          "404": {
            "description": "not-found — id inexistente O perteneciente a otro usuario (anti BOLA: mismo tratamiento, FR-019; no revela existencia)",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "IfUnmodifiedSince": {
        "name": "If-Unmodified-Since",
        "in": "header",
        "required": false,
        "description": "<updated_at> de la última lectura/escritura; si difiere del vigente → 412 stale-version",
        "schema": { "type": "string", "format": "date-time" }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "unauthorized / token-expired / token-revoked",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "RateLimited": {
        "description": "rate-limited (429)",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "Dependency": {
        "description": "dependency-unavailable (503)",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "BadRequest": {
        "description": "bad-request (body malformado)",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "NotFound": {
        "description": "not-found (404)",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "EmailExists": {
        "description": "email-exists (conflicto, case-insensitive)",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "description": "RFC 7807 — extensiones según el error (can_resend, current_updated_at, max_bytes, fields)",
        "required": ["type", "title", "status"],
        "properties": {
          "type": { "type": "string", "example": "https://api.example.com/errors/email-malformed" },
          "title": { "type": "string", "example": "Unprocessable Entity" },
          "status": { "type": "integer", "minimum": 400, "maximum": 599 },
          "detail": { "type": "string", "example": "an unexpected error occurred." },
          "instance": { "type": "string", "example": "/v1/auth/register" }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "description": "se normaliza server-side: trim + lowercase (FR-002)" },
          "password": { "type": "string", "description": "se envía tal cual (sin trim)" }
        }
      },
      "RegisterResponse": {
        "type": "object",
        "required": ["user"],
        "properties": { "user": { "$ref": "#/components/schemas/User" } }
      },
      "User": {
        "type": "object",
        "required": ["id", "email", "verified", "created_at"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "email": { "type": "string", "example": "juan@example.com" },
          "verified": { "type": "boolean" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "ResendRequest": {
        "type": "object",
        "required": ["email"],
        "properties": { "email": { "type": "string" } }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": { "email": { "type": "string" }, "password": { "type": "string" } }
      },
      "RefreshRequest": {
        "type": "object",
        "required": ["refresh_token"],
        "properties": { "refresh_token": { "type": "string" } }
      },
      "TokenPair": {
        "type": "object",
        "required": ["access_token", "refresh_token", "expires_in", "user"],
        "properties": {
          "access_token": { "type": "string", "example": "<jwt supabase>" },
          "refresh_token": { "type": "string", "example": "<token opaco supabase>" },
          "expires_in": { "type": "integer", "description": "TTL del proyecto Supabase — dinámico por respuesta", "example": 3600 },
          "user": { "$ref": "#/components/schemas/User" }
        }
      },
      "Link": {
        "type": "object",
        "required": ["type", "url"],
        "properties": {
          "type": { "type": "string", "maxLength": 40, "example": "linkedin" },
          "url": { "type": "string", "maxLength": 2048, "format": "uri" }
        }
      },
      "Profile": {
        "type": "object",
        "required": ["id", "email", "full_name", "created_at", "updated_at"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "email": { "type": "string" },
          "full_name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "headline": { "type": "string", "maxLength": 120, "nullable": true },
          "bio": { "type": "string", "maxLength": 2000, "nullable": true },
          "location": { "type": "string", "maxLength": 120, "nullable": true },
          "links": { "type": "array", "maxItems": 10, "items": { "$ref": "#/components/schemas/Link" } },
          "skills": { "type": "array", "maxItems": 30, "items": { "type": "string", "maxLength": 40 } },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "ProfileEnvelope": {
        "type": "object",
        "required": ["profile"],
        "properties": { "profile": { "$ref": "#/components/schemas/Profile" } }
      },
      "ProfileUpdate": {
        "type": "object",
        "required": ["full_name"],
        "properties": {
          "full_name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "headline": { "type": "string", "maxLength": 120, "nullable": true },
          "bio": { "type": "string", "maxLength": 2000, "nullable": true },
          "location": { "type": "string", "maxLength": 120, "nullable": true },
          "links": { "type": "array", "maxItems": 10, "items": { "$ref": "#/components/schemas/Link" } },
          "skills": {
            "type": "array",
            "maxItems": 30,
            "items": { "type": "string", "maxLength": 40 },
            "description": "sin duplicados"
          }
        }
      },
      "CvSaveRequest": {
        "type": "object",
        "required": ["content"],
        "properties": { "content": { "type": "string", "description": "UTF-8 válido; ≤ 51200 bytes (51200 exacto se acepta)" } }
      },
      "CvMeta": {
        "type": "object",
        "required": ["id", "updated_at"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "CvSaveResponse": {
        "type": "object",
        "required": ["cv", "previous_version_archived"],
        "properties": {
          "cv": { "$ref": "#/components/schemas/CvMeta" },
          "previous_version_archived": { "type": "boolean" }
        }
      },
      "Cv": {
        "type": "object",
        "required": ["id", "content", "created_at", "updated_at"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "content": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "CvEnvelope": {
        "type": "object",
        "required": ["cv"],
        "properties": { "cv": { "$ref": "#/components/schemas/Cv" } }
      },
      "VersionSummary": {
        "type": "object",
        "required": ["id", "origin", "archived_at"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "origin": { "type": "string", "enum": ["user"], "example": "user" },
          "archived_at": { "type": "string", "format": "date-time" }
        }
      },
      "CvVersionsEnvelope": {
        "type": "object",
        "required": ["versions"],
        "properties": {
          "versions": { "type": "array", "maxItems": 10, "items": { "$ref": "#/components/schemas/VersionSummary" } }
        }
      },
      "VersionDetail": {
        "allOf": [{ "$ref": "#/components/schemas/VersionSummary" }],
        "type": "object",
        "required": ["content"],
        "properties": { "content": { "type": "string" } }
      },
      "CvVersionEnvelope": {
        "type": "object",
        "required": ["version"],
        "properties": { "version": { "$ref": "#/components/schemas/VersionDetail" } }
      }
    }
  }
}